{
  "name": "ta_data_mas",
  "version": "1.0.0",
  "description": "Official JavaScript SDK for api database. For educational purposes only — not intended for production ",
  "author": "Argyrios",
  "license": "MIT",
  "repository": {
    "type": "git",
    "directory": "packages/apiDatabase-js"
  },
  "keywords": [
    "api_data",
    "backend",
    "database",
    "realtime",
    "auth",
    "storage"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "packageManager": "pnpm@10.9.0",
  "dependencies": {
    "socket.io-client": "^4.8.3",
    "uploadthing": "^7.7.4"
  },
  "devDependencies": {
    "@apiDatabase/types": "workspace:*",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  }
}
